<%_
  const pageName = pageData?.page || 'index';
  const pageDepth = (pageData?.slug || '').split('/').filter(Boolean).length;
  const assetBasePath = isDevelopment || site.pathMode !== 'relative'
    ? '/'
    : pageDepth === 0
      ? './'
      : '../'.repeat(pageDepth);
  const isWorksPage = pageName === 'works' || pageName.startsWith('works/');
  const titleName = pageData?.title ? `${pageData.title} | ` : '';

  const ogImage = site.defaultOgImage?.startsWith('http')
    ? site.defaultOgImage
    : site.pathMode === 'relative'
      ? `${assetBasePath}${site.defaultOgImage?.replace(/^\/+/, '') || 'assets/images/ogp.jpg'}`
      : site.defaultOgImage || '/assets/images/ogp.jpg';
-%>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="description" content="<%- site.defaultDescription %>">
<meta name="keywords" content="<%- site.defaultKeywords %>">
<%_ if (isWorksPage) { -%>
<meta name="robots" content="noindex,nofollow">
<%_ } -%>
<title><%- titleName %><%- site.siteName %></title>
<%# Sp -%>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="format-detection" content="telephone=no">
<%_ if (pageName === 'index') { -%>
<%# Ogp -%>
<meta property="og:title" content="<%- titleName %><%- site.siteName %>">
<meta property="og:type" content="website">
<meta property="og:description" content="<%- site.defaultDescription %>">
<meta property="og:image" content="<%- ogImage %>">
<meta property="og:url" content="<%- site.pathMode === 'relative' ? assetBasePath : '/' %>">
<meta property="og:locale" content="ja_JP">
<%# Twitter -%>
<meta name="twitter:card" content="summary">
<%_ } -%>
<%# Icon -%>
<link rel="icon" href="<%= assetBasePath %>favicon.ico">
<link rel="apple-touch-icon-precomposed" href="<%= assetBasePath %>assets/images/common/icon.png">
<%# Search Console -%>
<meta name="google-site-verification" content="c6jI19lhddWQQ44ZV4r4C2avprvo7yE5X65NhA8KLko" />
