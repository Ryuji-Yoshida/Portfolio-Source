<%_ if (pageData.slug === 'home') { -%>
<header class="header--site" data-js-elem="header">
  <div class="header--site__inner">
    <nav class="global__nav">
      <div class="global__nav-btn" data-js-trigger="menu">
        <div class="global__nav-btn__item">
          <p class="global__nav-btn__item-label">MENU</p>
        </div>
      </div>
      <ul class="global__nav-list">
        <li class="global__nav-list__item">
          <a href="#about" data-js-trigger="gnav">About</a>
        </li>
        <li class="global__nav-list__item">
          <a href="#profile" data-js-trigger="gnav">Profile</a>
        </li>
        <li class="global__nav-list__item">
          <a href="#works" data-js-trigger="gnav">Works</a>
        </li>
        <li class="global__nav-list__item">
          <a href="#service" data-js-trigger="gnav">Service &amp; Price</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
<%_ } else { -%>
<header class="header--site header--site-lower">
  <div class="header--site__inner">
    <h1 class="header--site__ttl">
      <%_ if (pageData.slug === 'works') { -%>
      <span>
      <%_ } else { -%>
      <a class="hover-opacity" href="./">
      <%_ } -%>
        <span class="header--site__ttl-logo"><%- fn.imgTag(`logo.svg`, 47, 36, `Markup Studio`, ``, ``) %></span>
        <span class="header--site__ttl-name">Ryuji Yoshida Portfolio Site</span>
      <%_ if (pageData.slug === 'works') { -%>
      </span>
      <%_ } else { -%>
      </a>
      <%_ } -%>
    </h1>
  </div>
</header>
<%_ } -%>
<%_ if (page != 'works') { -%>
<nav class="floatmenu" data-js-elem="floatmenu">
  <div class="floatmenu__item floatmenu__item-contact">
    <a class="hover-opacity" href="https://docs.google.com/forms/d/15lr8grXIJszh402G_Iw118qPoy3V2ZiMZInOEpnzgOc/" target="_blank">
      <span class="floatmenu__item--ic">
        <%- fn.imgTag('mail_ic.svg', 47, 36, { alt: '' }) %>
      </span>
      <span class="floatmenu__item--label">お問合せ</span>
    </a>
  </div>
  <div class="floatmenu__item floatmenu__item-sns">
    <a class="hover-opacity" href="https://www.facebook.com/yossiRyuu" target="_blank">
      <span class="floatmenu__item--ic">
        <%- fn.imgTag('facebook_ic.svg', 512, 512, { alt: 'facebook' }) %>
      </span>
    </a>
  </div>
  <div class="floatmenu__item floatmenu__item-totop">
    <a class="hover-opacity" href="#" data-js-trigger="anchor">
      <span class="floatmenu__item--ic">
        <svg xmlns="http://www.w3.org/2000/svg" height="48" viewBox="0 -960 960 960" width="48">
          <path d="M450-332h60v-182l74 74 42-42-146-146-146 146 42 42 74-74v182Zm30 252q-82 0-155-31.5t-127.5-86Q143-252 111.5-325T80-480q0-83 31.5-156t86-127Q252-817 325-848.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 82-31.5 155T763-197.5q-54 54.5-127 86T480-80Zm0-60q142 0 241-99.5T820-480q0-142-99-241t-241-99q-141 0-240.5 99T140-480q0 141 99.5 240.5T480-140Zm0-340Z"/>
        </svg>
      </span>
      <span class="floatmenu__item--label">ToTop</span>
    </a>
  </div>
</nav>
<%_ } -%>